# 聚合部署环境变量示例。复制为 .env.app 并按实际修改:
#   cp docker/.env.app.example docker/.env.app
#   docker compose -f docker/docker-compose.app.yml --env-file docker/.env.app up -d --build

# [必填] 宿主 LAN IP, 浏览器需可达。WebRTC ICE 候选通告此 IP, 设错会黑屏。
# 例: 192.168.100.239
ZLM_EXTERN_IP=192.168.100.239

# --- 外部数据库 (默认指向现有 MySQL) ---
DB_HOST=192.168.100.101
DB_PORT=23306
DB_NAME=onvif_cms
DB_USER=root
DB_PASSWORD=admin123

# --- ZLM / 业务密钥 (生产请改) ---
ZLM_SECRET=onvifCms2024SecretKey4ZlmApi
JWT_SECRET=please-change-me-to-a-very-long-random-string-at-least-32-bytes
ONVIF_AES_KEY=0123456789ABCDEF
